          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const sourceNode = ctx.createBufferSource();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
