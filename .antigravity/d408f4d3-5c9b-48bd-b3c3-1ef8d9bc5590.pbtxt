        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      for (let i = 0; i < numSamples; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const int16 = view.getInt16(i * 2, true);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        channelData[i] = int16 / 32768;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
