          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      sourceNode.start(nextStartTimeRef.current);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
