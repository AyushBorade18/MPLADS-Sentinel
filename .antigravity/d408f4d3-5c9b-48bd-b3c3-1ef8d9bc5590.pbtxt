  file_change {
    absolute_path_uri: "file:///src/pages/AIAssistantPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { useNavigate } from \'react-router-dom\';\nimport { aiService, ChatMessage } from \'../services/aiService\';\nimport { AIQueryResponse } from \'../data/mockAIKnowledge\';\nimport {\n  Sparkles,\n  Send,\n  Bot,\n  User,\n  ExternalLink,\n  ShieldAlert,\n  FileText,\n  Building,\n  CheckCircle2,\n  TrendingUp,\n  AlertTriangle,\n  Lightbulb,\n} from \'lucide-react\';\nimport {\n  ResponsiveContainer,\n  BarChart,\n  Bar,\n  XAxis,\n  YAxis,\n  Tooltip,\n  PieChart,\n  Pie,\n  Cell,\n} from \'recharts\';\n\nconst COLORS = [\'#2563eb\', \'#dc2626\', \'#f59e0b\', \'#10b981\', \'#64748b\'];\n\nconst suggestedPrompts = [\n  \'Identify top 5 delayed projects in Bihar\',\n  \'Check for vendor concentration in Kerala\',\n  \'Summarize expenditure trends for FY 23-24 with sector breakdown\',\n  \'Show me high-risk projects in Maharashtra\',\n  \'Why was project PRJ-2023-4921 flagged?\',\n];\n\nexport const AIAssistantPage: React.FC = () => {\n  const navigate = useNavigate();\n  const [messages, setMessages] = useState<ChatMessage[]>([\n    {\n      id: \'welcome\',\n      sender: \'assistant\',\n      timestamp: \'Just now\',\n      content:\n        \'Welcome to the Sentinel AI Intelligence Console. I perform forensic cross-referencing of MPLADS project allocations, contractor bidding clusters, geotagged evidence, and delay benchmarks. Select a query below or type an institutional question.\',\n    },\n  ]);\n  const [inputText, setInputText] = useState(\'\');\n  const [loading, setLoading] = useState(false);\n\n  const handleSend = async (queryText?: string) => {\n    const textToSend = queryText || inputText;\n    if (!textToSend.trim() || loading) return;\n\n    const userMsg: ChatMessage = {\n      id: `usr-${Date.now()}`,\n      sender: \'user\',\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n      content: textToSend,\n    };\n\n    setMessages((prev) => [...prev, userMsg]);\n    setInputText(\'\');\n    setLoading(true);\n\n    try {\n      const responsePayload = await aiService.queryAssistant(textToSend);\n      const assistantMsg: ChatMessage = {\n        id: `ai-${Date.now()}`,\n        sender: \'assistant\',\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\n        content: responsePayload.summary,\n        responsePayload,\n      };\n      setMessages((prev) => [...prev, assistantMsg]);\n    } catch (err) {\n      setMessages((prev) => [\n        ...prev,\n        {\n          id: `ai-err-${Date.now()}`,\n          sender: \'assistant\',\n          timestamp: \'Just now\',\n          content: \'Unable to analyze query against current ledger. Please try again.\',\n        },\n      ]);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6 max-w-5xl mx-auto\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-1\">\n            <Sparkles className=\"w-3 h-3\" />\n            RAG-Grounded Forensic Intelligence\n          </div>\n          <h1 className=\"text-2xl sm:text-3xl font-bold font-display text-slate-900 tracking-tight\">\n            Sentinel AI Assistant Console\n          </h1>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Query 4,520 MPLADS project ledgers, vendor associations, and statutory guidelines in real time.\n          </p>\n        </div>\n      </div>\n\n      {/* Suggested Quick Prompts */}\n      <div className=\"bg-white rounded-lg border border-slate-200 p-4 shadow-2xs\">\n        <p className=\"text-[11px] font-mono uppercase tracking-wider text-slate-500 font-semibold mb-2 flex items-center gap-1.5\">\n          <Lightbulb className=\"w-3.5 h-3.5 text-amber-500\" />\n          SUGGESTED AUDIT INVESTIGATIONS\n        </p>\n        <div className=\"flex flex-wrap gap-2\">\n          {suggestedPrompts.map((p, idx) => (\n            <button\n              key={idx}\n              onClick={() => handleSend(p)}\n              disabled={loading}\n              className=\"text-xs bg-slate-50 hover:bg-blue-50 hover:border-blue-300 hover:text-blue-700 text-slate-700 px-3 py-1.5 rounded-full border border-slate-200 transition-all font-medium text-left disabled:opacity-50\"\n            >\n              {p} &rarr;\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Chat Messages Log */}\n      <div className=\"bg-white rounded-lg border border-slate-200 p-6 shadow-2xs min-h-[480px] flex flex-col justify-between\">\n        <div className=\"space-y-6 overflow-y-auto max-h-[600px] pr-2\">\n          {messages.map((msg) => {\n            const isUser = msg.sender === \'user\';\n            const payload = msg.responsePayload;\n\n            return (\n              <div\n                key={msg.id}\n                className={`flex gap-3 text-xs ${isUser ? \'justify-end\' : \'justify-start\'}`}\n              >\n                {!isUser && (\n                  <div className=\"w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center shrink-0\">\n                    <Bot className=\"w-4 h-4\" />\n                  </div>\n                )}\n\n                <div\n                  className={`max-w-2xl rounded-lg p-4 space-y-3 ${\n                    isUser\n                      ? \'bg-blue-600 text-white font-medium shadow-2xs\'\n                      : \'bg-slate-50 border border-slate-200 text-slate-800 shadow-2xs\'\n                  }`}\n                >\n                  <div className=\"flex items-center justify-between text-[10px] opacity-70 pb-1 border-b border-current/10 font-mono\">\n                    <span>{isUser ? \'Auditor Query\' : \'Sentinel Forensic Engine\'}</span>\n                    <span>{msg.timestamp}</span>\n                  </div>\n\n                  <p className=\"text-sm leading-relaxed\">{msg.content}</p>\n\n                  {/* Structured Forensic Payload */}\n                  {payload && (\n                    <div className=\"space-y-4 pt-2 border-t border-slate-200\">\n                      {/* Key Insights */}\n                      {payload.keyInsights && (\n                        <div>\n                          <h5 className=\"font-semibold text-slate-900 mb-1.5 flex items-center gap-1\">\n                            <ShieldAlert className=\"w-3.5 h-3.5 text-blue-600\" />\n                            Forensic Findings:\n                          </h5>\n                          <ul className=\"list-disc pl-4 space-y-1 text-slate-700\">\n                            {payload.keyInsights.map((insight, i) => (\n                              <li key={i}>{insight}</li>\n                            ))}\n                          </ul>\n                        </div>\n                      )}\n\n                      {/* Embedded Rich Data Chart */}\n                      {payload.chartData && (\n                        <div className=\"p-3 bg-white rounded border border-slate-200\">\n                          <h6 className=\"font-mono text-[11px] font-bold text-slate-700 mb-2\">\n                            DATA VISUALIZATION SUMMARY\n                          </h6>\n                          <div className=\"h-40 w-full\">\n                            <ResponsiveContainer width=\"100%\" height=\"100%\">\n                              <BarChart data={payload.chartData} margin={{ top: 5, right: 10, left: -20, bottom: 0 }}>\n                                <XAxis dataKey=\"name\" tick={{ fontSize: 10, fontFamily: \'JetBrains Mono\' }} />\n                                <YAxis tick={{ fontSize: 10, fontFamily: \'JetBrains Mono\' }} />\n                                <Tooltip\n                                  contentStyle={{\n                                    backgroundColor: \'#0f172a\',\n                                    borderRadius: \'4px\',\n                                    color: \'#fff\',\n                                    fontSize: \'11px\',\n                                    fontFamily: \'JetBrains Mono\',\n                                  }}\n                                />\n                                <Bar dataKey={payload.chartData[0].delayDays !== undefined ? \'delayDays\' : payload.chartData[0].share !== undefined ? \'share\' : \'allocated\'} fill=\"#2563eb\" radius={[2, 2, 0, 0]} />\n                              </BarChart>\n                            </ResponsiveContainer>\n                          </div>\n                        </div>\n                      )}\n\n                      {/* Suggested Institutional Directive */}\n                      {payload.suggestedAction && (\n                        <div className=\"p-3 bg-amber-50/70 border border-amber-200 rounded text-slate-800\">\n                          <span className=\"font-bold text-amber-900 block mb-0.5\">\n                            Recommended Statutory Directive:\n                          </span>\n                          <p>{payload.suggestedAction}</p>\n                        </div>\n                      )}\n\n                      {/* Related Project Ledgers Direct Links */}\n                      {payload.relatedProjectIds && payload.relatedProjectIds.length > 0 && (\n                        <div>\n                          <span className=\"font-mono text-[10px] uppercase text-slate-500 font-semibold block mb-1\">\n                            AFFECTED PROJECT LEDGERS:\n                          </span>\n                          <div className=\"flex flex-wrap gap-2\">\n                            {payload.relatedProjectIds.map((pid) => (\n                              <button\n                                key={pid}\n                                onClick={() => navigate(`/projects/${pid}`)}\n                                className=\"inline-flex items-center gap-1 px-2.5 py-1 bg-white border border-blue-200 text-blue-700 hover:bg-blue-50 rounded font-mono font-medium\"\n                              >\n                                {pid} <ExternalLink className=\"w-3 h-3\" />\n                              </button>\n                            ))}\n                          </div>\n                        </div>\n                      )}\n\n                      {/* Source Documents & Citations */}\n                      {payload.sourceDocuments && (\n                        <div className=\"pt-2 border-t border-slate-200 text-[10px] text-slate-500 font-mono\">\n                          <span className=\"font-semibold block mb-1\">AUDIT CITATIONS:</span>\n                          {payload.sourceDocuments.map((doc, idx) => (\n                            <div key={idx} className=\"truncate text-slate-600\">\n                              \342\200\242 {doc}\n                            </div>\n                          ))}\n                        </div>\n                      )}\n                    </div>\n                  )}\n                </div>\n\n                {isUser && (\n                  <div className=\"w-8 h-8 rounded-full bg-slate-800 text-white flex items-center justify-center shrink-0\">\n                    <User className=\"w-4 h-4\" />\n                  </div>\n                )}\n              </div>\n            );\n          })}\n\n          {loading && (\n            <div className=\"flex gap-3 text-xs\">\n              <div className=\"w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center shrink-0\">\n                <Bot className=\"w-4 h-4\" />\n              </div>\n              <div className=\"bg-slate-50 border border-slate-200 rounded-lg p-4 text-slate-500 flex items-center gap-2\">\n                <Sparkles className=\"w-4 h-4 text-blue-600 animate-spin\" />\n                <span>Running cross-ledger forensic calculations...</span>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Input Bar */}\n        <div className=\"pt-4 mt-4 border-t border-slate-200\">\n          <form\n            onSubmit={(e) => {\n              e.preventDefault();\n              handleSend();\n            }}\n            className=\"flex items-center gap-2\"\n          >\n            <input\n              type=\"text\"\n              value={inputText}\n              onChange={(e) => setInputText(e.target.value)}\n              placeholder=\"Ask Sentinel AI (e.g. \'Show me delayed health centers in UP\' or \'Audit contractor concentration in Baramati\')...\"\n              className=\"flex-1 border border-slate-200 rounded-lg px-4 py-2.5 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-600\"\n            />\n            <button\n              type=\"submit\"\n              disabled={!inputText.trim() || loading}\n              className=\"px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold shadow-2xs transition-colors disabled:opacity-50 flex items-center gap-1.5\"\n            >\n              <span>Ask</span>\n              <Send className=\"w-3.5 h-3.5\" />\n            </button>\n          </form>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
